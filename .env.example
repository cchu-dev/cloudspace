HOST=127.0.0.1
PORT=7676
# Owner password generated by `cloudspace init` in ~/.cloudspace/auth.json. Set this
# only for non-interactive or fully env-driven deployments.
# CLOUDSPACE_OAUTH_OWNER_TOKEN=change-me-to-a-long-random-secret
# Optional OAuth tuning.
# CLOUDSPACE_OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
# CLOUDSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
# CLOUDSPACE_OAUTH_SCOPES=cloudspace
# CLOUDSPACE_OAUTH_ALLOWED_REDIRECT_HOSTS=chatgpt.com,localhost,127.0.0.1
CLOUDSPACE_ALLOWED_ROOTS=/home/waishnav/personal,/home/waishnav/work
# For temporary tunnels, prefer setting this per run. Cloudspace derives the
# inbound Host allowlist from this URL.
# CLOUDSPACE_PUBLIC_BASE_URL=https://your-public-host.example.com
# Advanced escape hatch. `*` disables Host header allowlist protection.
# CLOUDSPACE_ALLOWED_HOSTS=localhost,127.0.0.1,your-public-host.example.com
CLOUDSPACE_TOOL_MODE=full
CLOUDSPACE_TOOL_NAMING=legacy
# off | changes | full. Defaults to changes.
# changes creates one aggregate review widget via review_changes instead of per-tool iframes.
CLOUDSPACE_WIDGETS=changes
CLOUDSPACE_LOG_LEVEL=info
CLOUDSPACE_LOG_FORMAT=json
CLOUDSPACE_LOG_REQUESTS=1
CLOUDSPACE_LOG_ASSETS=0
CLOUDSPACE_LOG_TOOL_CALLS=1
CLOUDSPACE_LOG_SHELL_COMMANDS=0
# CLOUDSPACE_TRUST_PROXY=1
# CLOUDSPACE_STATE_DIR=/home/waishnav/.local/share/cloudspace
# CLOUDSPACE_WORKTREE_ROOT=/home/waishnav/.cloudspace/worktrees
# CLOUDSPACE_AUTO_LOAD_AGENTS_MD=1
# Skills are enabled by default. Set CLOUDSPACE_SKILLS=0 to hide them.
# CLOUDSPACE_SKILLS=0
# CLOUDSPACE_AGENT_DIR=/home/waishnav/.codex
# CLOUDSPACE_SKILL_PATHS=/home/waishnav/.codex/skills,/home/waishnav/.claude/skills
