# Cloudspace production environment for Docker Compose on Oracle Cloud Ubuntu.
# Copy this file to /etc/cloudspace/cloudspace.env and keep it readable only by root.

# Stable Compose project name keeps Docker volume names predictable:
# cloudspace_cloudspace-data, cloudspace_caddy-data, cloudspace_caddy-config.
COMPOSE_PROJECT_NAME=cloudspace

# Public DNS name pointed at this VM. Caddy uses this for automatic HTTPS.
CLOUDSPACE_HOSTNAME=cloudspace.example.com

# Optional override. Leave commented to let docker-compose.yml derive
# https://$CLOUDSPACE_HOSTNAME.
# CLOUDSPACE_PUBLIC_BASE_URL=https://cloudspace.example.com

# Owner password for the OAuth approval form. Generate a fresh value:
# openssl rand -base64 32
CLOUDSPACE_OAUTH_OWNER_TOKEN=change-me-generate-a-strong-secret

# Host directory exposed to Cloudspace. The container always sees this as
# /workspace, so keep CLOUDSPACE_ALLOWED_ROOTS=/workspace even when the host path
# is changed to an existing directory such as /home/ubuntu/workspaces.
CLOUDSPACE_WORKSPACE_PATH=/srv/cloudspace/workspace
CLOUDSPACE_ALLOWED_ROOTS=/workspace

# Docker/public deployment default: refresh tokens expire after 7 days.
CLOUDSPACE_OAUTH_REFRESH_TOKEN_TTL_SECONDS=604800

# Production logging defaults.
CLOUDSPACE_LOG_FORMAT=json
CLOUDSPACE_LOG_LEVEL=info
CLOUDSPACE_TRUST_PROXY=1
